PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_random_secret

# Comma-separated allowed origins for CORS
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Set true if you want to allow all Vercel preview URLs (*.vercel.app)
CORS_ALLOW_VERCEL_PREVIEWS=true

# OAuth callback and client credentials
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MS_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
